# Copy file này thành .env rồi điền giá trị thật
# cp .env.example .env

# Database password (đổi thành mật khẩu mạnh)
POSTGRES_PASSWORD=bida_strong_password_here

# JWT secret (đổi thành chuỗi ngẫu nhiên dài)
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Port (mặc định 3000)
PORT=3000
